# База данных
DB_USER=justify_app
DB_PASSWORD=alim20077
DB_SERVER=localhost  # Или IP-адрес вашего SQL Server
DB_NAME=JustifyMusicDB
DB_PORT=1433     

# Apollo Server
GRAPHQL_PORT=4000             # Порт для GraphQL-сервера
GRAPHQL_PATH=/graphql         # Путь для GraphQL API

# JWT Token
JWT_SECRET=your_jwt_secret_key   # Секретный ключ для подписи JWT токенов
JWT_EXPIRATION=3600              # Время жизни токена в секундах

# Настройки приложения
APP_ENV=development             # Среда (development или production)
APP_URL=http://localhost:4000   # URL приложения

# Логирование
LOG_LEVEL=debug                 # Уровень логирования (debug, info, warn, error)
